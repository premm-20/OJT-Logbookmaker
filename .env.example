# Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================
# Neon Auth (Managed Better Auth): student sign in / sign up
# ============================================================
# Neon Console > your project > Auth > Configuration > Auth URL
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth
# Signs Neon Auth's session cache cookie. 32+ characters.
# Generate one with:  openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace_with_a_long_random_string

# Signs the admin portal token. 32+ characters. Required in production.
AUTH_SECRET=replace_with_a_long_random_string

# Admin portal (/admin) login. Admin login is refused when either is unset.
# Use a long, unique password; it is never stored in the code.
ADMIN_USERNAME=your_admin_id
ADMIN_PASSWORD=replace_with_a_long_unique_password

# ============================================================
# Neon PostgreSQL Database
# ============================================================
# Get this from your Neon console: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# ============================================================
# AI keys (a pool: list several, comma separated)
# ============================================================
# Requests rotate across every key, and a key that hits its rate limit
# rests while the others take over. Gemini keys are tried first.
# Gemini: https://aistudio.google.com/app/apikey
#   Free quota is per Google Cloud project, so keys from the same project
#   share one limit. Make each key in a different project.
GEMINI_API_KEYS=key_one,key_two
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite
# OpenRouter: https://openrouter.ai/keys
#   Free models only: anything without ":free" is ignored, so you are never
#   charged. Limits are per account: 50 requests a day, or 1000 a day once
#   the account has bought $10 of credits (one time).
OPENROUTER_API_KEYS=key_one
OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
