# Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================
# Authentication
# ============================================================
# Signs session cookies and email verification codes. Required in production.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=replace_with_a_long_random_string

# Google sign-in (Google Identity Services).
# Create an OAuth "Web application" client at https://console.cloud.google.com/apis/credentials
# and add every origin you serve from (e.g. http://localhost:3000 and your
# production URL) under "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Admin portal (/admin) login. Admin login is refused when either is unset.
# Use a long, unique password; it is never stored in the code.
ADMIN_USERNAME=your_admin_id
ADMIN_PASSWORD=replace_with_a_long_unique_password

# ============================================================
# Neon PostgreSQL Database
# ============================================================
# Get this from your Neon console: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# ============================================================
# Google Gemini AI
# ============================================================
# Get this from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ============================================================
# Email Dispatch (Gmail SMTP) for sign-up and password-reset codes
# ============================================================
# Create a 16-character App Password: https://myaccount.google.com/apppasswords
# Without SMTP in local development, codes are printed in the terminal and
# shown on the page instead.
SMTP_USER=ojtlogbookmaker@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
