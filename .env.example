# Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================
# Neon Auth (Managed Better Auth): student sign in / sign up
# ============================================================
# Neon Console > your project > Auth > Configuration > Auth URL
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth
# Signs Neon Auth's session cache cookie. 32+ characters.
# Generate one with:  openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace_with_a_long_random_string

# Signs the admin portal token. 32+ characters. Required in production.
AUTH_SECRET=replace_with_a_long_random_string

# Admin portal (/admin) login. Admin login is refused when either is unset.
# Use a long, unique password; it is never stored in the code.
ADMIN_USERNAME=your_admin_id
ADMIN_PASSWORD=replace_with_a_long_unique_password

# ============================================================
# Neon PostgreSQL Database
# ============================================================
# Get this from your Neon console: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# ============================================================
# Google Gemini AI
# ============================================================
# Get this from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
